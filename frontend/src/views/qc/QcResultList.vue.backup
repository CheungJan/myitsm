<template><div class="page"><div class="page-header"><h2>质检结果</h2><div style="display:flex;gap:8px"><el-button type="primary" size="small" @click="openCreate">录入质检</el-button></div></div><el-card shadow="never" style="margin-bottom:16px"><div class="search-bar"><div class="field"><label>搜索</label><el-input v-model="s.search" placeholder="单号/物料/SN" size="small" style="width:180px" clearable @keyup.enter="doSearch"/></div><el-button type="primary" size="small" @click="doSearch" style="margin-left:auto">查询</el-button></div></el-card><el-card shadow="never" style="margin-bottom:16px" v-if="stats.length"><div style="display:flex;gap:16px;flex-wrap:wrap"><div v-for="st in stats" :key="st.qcstatus" style="text-align:center;padding:8px 16px;background:#f5f7fa;border-radius:6px"><div style="font-size:20px;font-weight:600;color:#409eff">{{ st.cnt }}</div><div style="font-size:12px;color:#909399">{{ qcLabel(st.qcstatus) }}</div></div></div></el-card>
  <el-card shadow="never" style="margin-bottom:16px">
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      <el-card shadow="hover" @click="drillOvw('pending')" style="cursor:pointer;flex:1;min-width:120px"><div style="text-align:center"><div style="font-size:24px;font-weight:600;color:#1677ff">{{ comp.pending_ov5 }}</div><div style="font-size:12px;color:#909399;margin-top:4px">待质检 OV=5</div></div></el-card>
      <el-card shadow="hover" @click="drillOvw('done')" style="cursor:pointer;flex:1;min-width:120px"><div style="text-align:center"><div style="font-size:24px;font-weight:600;color:#52c41a">{{ comp.total_ov5 - comp.pending_ov5 }}</div><div style="font-size:12px;color:#909399;margin-top:4px">已完成 OV=5</div></div></el-card>
      <el-card shadow="hover" @click="drillOvw('iv11')" style="cursor:pointer;flex:1;min-width:120px"><div style="text-align:center"><div style="font-size:24px;font-weight:600;color:#fa8c16">{{ comp.iv11_count }}</div><div style="font-size:12px;color:#909399;margin-top:4px">IV=11 入库单</div></div></el-card>
      <el-card shadow="hover" @click="drillOvw('ovout')" style="cursor:pointer;flex:1;min-width:120px"><div style="text-align:center"><div style="font-size:24px;font-weight:600;color:#ff4d4f">{{ comp.ov_out_count }}</div><div style="font-size:12px;color:#909399;margin-top:4px">不合格出库单</div></div></el-card>
    </div>
  </el-card>

  <el-dialog :title="drillTitle" v-model="drillVisible" width="750px">
    <el-table :data="drillItems" size="small" stripe v-loading="drillLoading" max-height="420">
      <el-table-column prop="billid" :label="drillColLabel" width="120"/>
      <el-table-column prop="type" label="类型" width="130"/>
      <el-table-column prop="whcd" label="仓库" width="80"/>
      <el-table-column label="审核" width="60"><template #default="{row}"><el-tag :type="row.audited?'success':'info'" size="small">{{ row.audited?'已审':'待审' }}</el-tag></template></el-table-column>
      <el-table-column prop="gendate" label="日期" width="100"/>
      <el-table-column label="操作" width="60"><template #default="{row}"><el-button link type="primary" size="small" @click="openWarehouse(row)">查看</el-button></template></el-table-column>
    </el-table>
  </el-dialog>

<el-card shadow="never"><el-table :data="items" v-loading="loading" stripe size="small" highlight-current-row @row-click="openDrawer"><el-table-column prop="qcbillid" label="质检单号" width="110"/><el-table-column prop="itemcd" label="物料" width="90"/><el-table-column prop="eid" label="设备SN" width="140"/><el-table-column label="质检状态" width="80"><template #default="{row}"><el-tag :type="qcTagType(row.qcstatus)" size="small">{{ qcLabel(row.qcstatus) }}</el-tag></template></el-table-column><el-table-column label="审核" width="70"><template #default="{row}"><el-tag :type="row.auditflg==='1'?'success':row.auditflg==='8'?'danger':row.auditflg==='V'?'info':'warning'" size="small">{{ row.auditflg==='1'?'已审':row.auditflg==='8'?'已退回':row.auditflg==='V'?'已作废':'待审' }}</el-tag></template></el-table-column><el-table-column prop="refbillid" label="关联单号" width="110"/><el-table-column prop="gendate" label="日期" width="100"/><el-table-column label="操作员" width="80"><template #default="{row}">{{ userName(row.opercd) }}</template></el-table-column><el-table-column label="操作" width="80"><template #default="{row}"><el-button v-if="row.auditflg==='0'||row.auditflg==='8'" link type="danger" size="small" @click.stop="handleVoid(row)">作废</el-button></template></el-table-column></el-table><AppPagination v-model:current-page="page" v-model:page-size="perPage" :total="total" style="margin-top:12px;justify-content:flex-end"/></el-card>

    <el-dialog :title="'质检单 — '+(detail?.qcbillid||'')" v-model="drawer" width="650px"><template v-if="detail"><el-descriptions :column="2" border size="small"><el-descriptions-item label="单号">{{ detail.qcbillid }}</el-descriptions-item><el-descriptions-item label="物料">{{ detail.itemcd }}</el-descriptions-item><el-descriptions-item label="设备SN">{{ detail.eid||'-' }}</el-descriptions-item><el-descriptions-item label="状态">{{ qcLabel(detail.qcstatus) }}</el-descriptions-item><el-descriptions-item label="关联单号">{{ detail.refbillid||'-' }}</el-descriptions-item><el-descriptions-item label="操作员">{{ userName(detail.opercd) }}</el-descriptions-item><el-descriptions-item label="审核人">{{ detail.auditman||'-' }}</el-descriptions-item><el-descriptions-item label="审核日期">{{ detail.auditdate||'-' }}</el-descriptions-item><el-descriptions-item label="日期">{{ detail.gendate }}</el-descriptions-item><el-descriptions-item label="备注" :span="2">{{ detail.memo||'-' }}</el-descriptions-item></el-descriptions><!-- 明细：按产品 --><template v-if="(detail.details||[]).length>0"><h4 style="margin:16px 0 8px">明细（按产品）</h4><el-table :data="detail.details" size="small" stripe><el-table-column prop="itemcd" label="物料" width="90"/><el-table-column label="质检结果" width="80"><template #default="{row}">{{ qcLabel(row.qcstatus) }}</template></el-table-column><el-table-column prop="qcqty" label="质检数" width="70"/><el-table-column prop="inqty" label="入库数" width="70"/><el-table-column label="批次日期" width="100"><template #default="{row}">{{ row.prddate || '-' }}</template></el-table-column><el-table-column prop="ref_rgstbillid" label="关联单号" width="110"/></el-table></template><!-- 明细：按EID --><template v-if="(detail.eid_details||[]).length>0"><h4 style="margin:16px 0 8px">明细（按EID）</h4><el-table :data="detail.eid_details" size="small" stripe><el-table-column prop="itemcd" label="物料" width="90"/><el-table-column prop="eid" label="EID" width="140"/><el-table-column prop="manuf_seq" label="原厂序号" width="130"/><el-table-column label="质检结果" width="80"><template #default="{row}">{{ qcLabel(row.qcstatus) }}</template></el-table-column><el-table-column prop="qcqty" label="质检数" width="70"/><el-table-column prop="inqty" label="入库数" width="70"/><el-table-column prop="ref_rgstbillid" label="关联单号" width="110"/></el-table></template><template v-if="(detail.eid_details||[]).length>0"><h4 style="margin:16px 0 8px">明细（按EID）</h4><el-table :data="detail.eid_details" size="small" stripe><el-table-column prop="itemcd" label="物料" width="90"/><el-table-column prop="eid" label="EID" width="140"/><el-table-column prop="manuf_seq" label="原厂序号" width="130"/><el-table-column label="质检结果" width="80"><template #default="{row}">{{ qcLabel(row.qcstatus) }}</template></el-table-column><el-table-column prop="qcqty" label="质检数" width="70"/><el-table-column prop="inqty" label="入库数" width="70"/></el-table></template><div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end"><el-button v-if="detail.auditflg!=='1'&&detail.auditflg!=='V'" type="danger" size="small" :loading="auditing" @click.stop="doReject(detail.qcbillid)">审核退回</el-button><el-button v-if="detail.auditflg!=='1'&&detail.auditflg!=='V'" type="success" size="small" :loading="auditing" @click.stop="doAudit(detail.qcbillid)">审核通过</el-button></div></template></el-dialog>

    <el-dialog title="录入质检结果" v-model="creating" width="450px" @closed="resetForm"><el-form :model="form" label-width="80px" size="small"><el-form-item label="物料编码" required><el-input v-model="form.itemcd" placeholder="输入物料编码"/></el-form-item><el-form-item label="设备SN"><el-input v-model="form.eid" placeholder="设备序列号（选填）"/></el-form-item><el-form-item label="关联单号"><el-input v-model="form.refbillid" placeholder="关联入库单/采购单"/></el-form-item><el-form-item label="质检状态"><el-select v-model="form.qcstatus" style="width:100%"><el-option label="合格" value="1"/><el-option label="不合格" value="0"/></el-select></el-form-item><el-form-item label="备注"><el-input v-model="form.memo" type="textarea" :rows="2"/></el-form-item></el-form><template #footer><el-button @click="creating=false">取消</el-button><el-button type="primary" @click="doCreate" :loading="saving">提交</el-button></template></el-dialog></div></template>
<script setup lang="ts">import {ref,reactive,onMounted} from 'vue';import {ElMessage,ElMessageBox} from 'element-plus';import AppPagination from '@/components/common/AppPagination.vue';import {useListPage} from '@/composables/useListPage';import {useDetailDrawer} from '@/composables/useDetailDrawer';import {useUserNames} from '@/composables/useUserNames';import {fetchQcResults,fetchQcDetail,fetchQcStats,fetchQcCompletion,createQcResult,auditQcResult,voidQcResult,type QcRecord} from '@/api/qc';import {fetchStockOut,fetchStockIn,fetchQcOutOrders} from '@/api/warehouse';import {useDict} from '@/composables/useDict'
const{items,loading,page,perPage,total,onSearch}=useListPage<QcRecord>(fetchQcResults)
const{drawer,detail,open}=useDetailDrawer<QcRecord>();const{userName}=useUserNames()
const{dictLabel:qcLabel}=useDict('QC')
function qcTagType(s:string):string{const m:Record<string,string>={GA:'success',BF:'danger',DJ:'warning',GC:'info'};return m[s]||'info'}
const s=reactive({search:''})
const stats=ref<{qcstatus:string;cnt:number}[]>([])
const comp=ref<{total_ov5:number;done_ov5:number;pending_ov5:number;iv11_count:number;ov_out_count:number}>({total_ov5:0,done_ov5:0,pending_ov5:0,iv11_count:0,ov_out_count:0})
import {useRouter} from 'vue-router'
const router=useRouter()
const drillVisible=ref(false);const drillLoading=ref(false);const drillTitle=ref('');const drillColLabel=ref('单号')
const drillItems=ref<{billid:string;type:string;whcd:string;audited:boolean;gendate:string;url:string}[]>([])

async function drillOvw(kind:string){
    drillVisible.value=true;drillLoading.value=true
    if(kind==='pending'){drillTitle.value='待质检 OV=5 出库单';drillColLabel.value='出库单号'
        try{const r=await fetchQcOutOrders();drillItems.value=(r.data||[]).map((o:any)=>({billid:o.outbillid,type:'OV=5质检出库',whcd:o.whcd||'',audited:true,gendate:o.gendate?.substring(0,10)||'',url:'/warehouse/stock-out'}))}catch{}}
    else if(kind==='done'){drillTitle.value='已全部QC完成的 OV=5';drillColLabel.value='出库单号'
        try{const pendingR=await fetchQcOutOrders();const pendingIds=new Set((pendingR.data||[]).map((o:any)=>o.outbillid))
            const allR=await fetchStockOut({invtyp:'5',auditflg:'2',per_page:'100'} as any)
            drillItems.value=((allR.data?.items||[]) as any[]).filter((o:any)=>!pendingIds.has(o.outbillid)).map((o:any)=>({billid:o.outbillid,type:'OV=5质检出库',whcd:o.whcd||o.whnm||'',audited:true,gendate:o.gendate?.substring(0,10)||'',url:'/warehouse/stock-out'}))}catch{}}
    else if(kind==='iv11'){drillTitle.value='QC生成的 IV=11 质检入库单';drillColLabel.value='入库单号'
        try{const r=await fetchStockIn({invtyp:'11',per_page:'100'} as any)
            drillItems.value=((r.data?.items||[]) as any[]).map((i:any)=>({billid:i.inbillid,type:'IV=11质检入库',whcd:i.whcd||i.whnm||'',audited:i.auditflg==='2',gendate:i.gendate?.substring(0,10)||'',url:'/warehouse/stock-in'}))}catch{}}
    else if(kind==='ovout'){drillTitle.value='QC生成的不合格出库单 (OV=6/7/9)';drillColLabel.value='出库单号'
        try{
            const types=['6','7','9'];let all:any[]=[]
            for(const t of types){const r=await fetchStockOut({invtyp:t,per_page:'100'} as any);all.push(...((r.data?.items||[]) as any[]))}
            drillItems.value=all.filter((o:any)=>o.refbillid?.startsWith('QC')).map((o:any)=>({billid:o.outbillid,type:'OV='+o.invtyp+({6:'退换',7:'报废',9:'返修'}[o.invtyp]||''),whcd:o.whcd||o.whnm||'',audited:o.auditflg==='2',gendate:o.gendate?.substring(0,10)||'',url:'/warehouse/stock-out'}))}catch{}}
    drillLoading.value=false
}
function openWarehouse(row:any){router.push({path:row.url})}

function doSearch(){onSearch(s.search?{search:s.search}:{})}
onMounted(async()=>{try{const r=await fetchQcStats();stats.value=r.data||[]}catch{};try{const r=await fetchQcCompletion();comp.value=r.data||comp.value}catch{}})
async function openDrawer(row:QcRecord){drawer.value=true;try{const r=await fetchQcDetail(row.qcbillid);detail.value=r.data}catch{detail.value=row}}
const creating=ref(false);const saving=ref(false);const auditing=ref(false)
const form=reactive({itemcd:'',eid:'',refbillid:'',qcstatus:'1',memo:''})
function openCreate(){creating.value=true}
function resetForm(){form.itemcd='';form.eid='';form.refbillid='';form.qcstatus='1';form.memo=''}
async function doCreate(){if(!form.itemcd){ElMessage.warning('请输入物料编码');return};saving.value=true;try{await createQcResult({...form});ElMessage.success('录入成功');creating.value=false;load()}catch(e:any){ElMessage.error(e?.response?.data?.message||'录入失败')}finally{saving.value=false}}
async function doAudit(id:string){auditing.value=true;try{await auditQcResult(id,'1');ElMessage.success('审核成功');load()}catch(e:any){ElMessage.error(e?.response?.data?.message||'审核失败')}finally{auditing.value=false}}
async function doReject(id:string){auditing.value=true;try{const {value:memo}=await ElMessageBox.prompt('请输入退回原因','审核退回',{confirmButtonText:'确认退回',cancelButtonText:'取消',type:'warning'});await auditQcResult(id,'8',memo||'');ElMessage.success('已退回');load()}catch{/* 取消 */}finally{auditing.value=false}}
async function handleVoid(row:QcRecord){try{await ElMessageBox.confirm(`确定作废质检单 ${row.qcbillid} 吗？`,'确认作废',{type:'warning'});await voidQcResult(row.qcbillid);ElMessage.success('已作废');load()}catch{/* 取消 */}}
</script>
<style scoped>.page{padding:0}.page-header{display:flex;justify-content:space-between;margin-bottom:16px}.page-header h2{font-size:18px;font-weight:600;margin:0}.search-bar{display:flex;gap:12px;align-items:center}.field{display:flex;align-items:center;gap:6px}.field label{font-size:13px;color:#606266}</style>
